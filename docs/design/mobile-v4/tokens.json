{
  "$schema": "Sollin Mobile design tokens v1 · 数值单位：逻辑像素（dp / pt）；颜色为 sRGB hex 或 rgba",
  "color": {
    "dark": {
      "bg": "#0A0B11", "bgElev": "#101119", "surface1": "#14151D", "surface2": "#1A1C26", "surface3": "#242735",
      "line": "rgba(255,255,255,0.07)", "lineStrong": "rgba(255,255,255,0.12)",
      "text1": "#F3F4F8", "text2": "#A6ABBB", "text3": "#6C7186", "text4": "#454A5C",
      "glass": "rgba(20,21,30,0.58)", "glassStrong": "rgba(24,25,34,0.82)", "glassLine": "rgba(255,255,255,0.09)"
    },
    "light": {
      "bg": "#F5F5F8", "bgElev": "#FFFFFF", "surface1": "#FFFFFF", "surface2": "#EEF0F4", "surface3": "#E3E6EC",
      "line": "rgba(12,14,24,0.07)", "lineStrong": "rgba(12,14,24,0.12)",
      "text1": "#12131A", "text2": "#5A5F6F", "text3": "#8C91A1", "text4": "#C2C6D0",
      "glass": "rgba(255,255,255,0.66)", "glassStrong": "rgba(255,255,255,0.9)", "glassLine": "rgba(12,14,24,0.08)"
    },
    "player": { "note": "播放器与播放器内 Sheet 始终使用 dark 令牌", "text1": "#FFFFFF", "text2": "rgba(255,255,255,0.66)", "text3": "rgba(255,255,255,0.40)", "track": "rgba(255,255,255,0.16)" },
    "semantic": { "ok": "#5EE6A8", "warn": "#FFC266", "danger": "#FF6B6B", "info": "#8AB4FF" },
    "accents": [
      { "id": "gold",   "name": "鎏金", "fill": "#F4D28A", "textOnLight": "#93650F", "ink": "#1B1508", "default": true },
      { "id": "blue",   "name": "星蓝", "fill": "#8AB4FF", "textOnLight": "#2F5FD0", "ink": "#08142B" },
      { "id": "aurora", "name": "极光", "fill": "#6EE7C8", "textOnLight": "#0E8A6C", "ink": "#04201A" },
      { "id": "violet", "name": "霓紫", "fill": "#B79CFF", "textOnLight": "#6B45D6", "ink": "#160A33" },
      { "id": "pink",   "name": "樱粉", "fill": "#FF9CC2", "textOnLight": "#C23A72", "ink": "#2B0816" },
      { "id": "flame",  "name": "赤焰", "fill": "#FF7A66", "textOnLight": "#C93C28", "ink": "#2B0A05" }
    ],
    "accentDerived": { "soft": "accent @ 14% (dark) / 16% (light)", "glow": "accent @ 38%", "textDark": "= fill", "textLight": "= textOnLight" },
    "settingTiles": { "violet": "#7C6CF2", "blue": "#3D8BF4", "orange": "#F2994A", "green": "#2FB47C", "red": "#EB5757", "pink": "#E0559B", "gold": "#C9A04A", "cyan": "#2CB5D6", "gray": "#6E7385", "teal": "#1FA38E" }
  },
  "type": {
    "family": ["SF Pro Text", "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC"],
    "familyNumeric": ["SF Pro Rounded", "DIN Alternate"],
    "scale": {
      "display":    { "size": 30, "weight": 750, "lineHeight": 1.2, "use": "Tab 页大标题" },
      "title":      { "size": 22, "weight": 750, "lineHeight": 1.3, "use": "播放器歌名、详情页标题" },
      "headline":   { "size": 19, "weight": 700, "lineHeight": 1.3, "use": "区块标题" },
      "appBar":     { "size": 17, "weight": 650, "lineHeight": 1.2, "use": "二级页顶栏" },
      "body":       { "size": 15, "weight": 600, "lineHeight": 1.4, "use": "列表主标题" },
      "bodyRegular":{ "size": 14, "weight": 400, "lineHeight": 1.6, "use": "段落" },
      "caption":    { "size": 12.5, "weight": 400, "lineHeight": 1.4, "use": "副标题" },
      "micro":      { "size": 11, "weight": 600, "lineHeight": 1.2, "use": "徽章、组标题" },
      "lyric":      { "size": 26, "weight": 750, "lineHeight": 1.32, "range": [16, 40] },
      "lyricTranslation": { "size": 15, "weight": 550, "range": [11, 22] }
    }
  },
  "space": { "grid": 4, "pagePadding": 20, "gap": 12, "sectionTop": 22, "sectionBottom": 12 },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 28, "full": 999, "coverRow": 10, "coverCard": 16, "coverPlayer": 22, "sheetTop": 28, "dialog": 26 },
  "size": {
    "statusBar": 50, "appBar": 52, "touchTarget": 44, "row": 64, "rowCover": 48, "settingRow": 54, "settingTile": 30,
    "button": 48, "buttonSmall": 36, "chip": 34, "segment": 40, "field": 52, "switch": [50, 30], "sliderTrack": 4, "sliderThumb": 22,
    "miniPlayer": 60, "miniCover": 44,
    "navIsland": { "height": 64, "radius": 32, "side": 12, "bottom": 28 },
    "navBar": { "height": 83, "contentHeight": 53, "safeBottom": 30 },
    "playerCover": 326, "playButton": 76, "progressHit": 20, "progressTrack": 4, "progressTrackDrag": 8
  },
  "blur": { "glass": 26, "glassSaturate": 1.5, "sheetDark": 30, "playerBlur": 70, "toast": 20 },
  "elevation": {
    "shadow1": "0 6 18 rgba(0,0,0,0.28)",
    "shadow2": "0 14 40 rgba(0,0,0,0.42)",
    "accentGlow": "0 8 24 accent@38%"
  },
  "motion": {
    "duration": { "fast": 160, "base": 240, "slow": 380, "playerOpen": 460, "playerClose": 300, "sheetOpen": 380, "sheetClose": 240, "toastStay": 1900, "lyricScroll": 720, "bannerInterval": 4500, "lyricAutoReturn": 4000 },
    "curve": {
      "out": [0.22, 1, 0.36, 1],
      "standard": [0.4, 0, 0.2, 1],
      "springCss": [0.34, 1.56, 0.64, 1],
      "springPhysics": { "lyricScroll": { "stiffness": 170, "damping": 18, "mass": 1 }, "buttonPress": { "stiffness": 400, "damping": 22 }, "sliderThumb": { "stiffness": 500, "damping": 20 } }
    },
    "loops": { "vinylRotate": 7000, "breathe": 3600, "pulseRing": 2600, "pulseRingStagger": 850, "flowBackground": 22000, "ambientBlob": [13000, 17000], "marquee": 11000, "marqueePause": "首 18%" }
  }
}
