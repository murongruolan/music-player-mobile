<?xml version="1.0" encoding="utf-8"?>
<!-- 默认只允许 https；酷狗 / 酷我 / 咪咕的部分公开接口和图床只有 http（桌面端同样如此），只对这些域名放行明文 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">kugou.com</domain>
        <domain includeSubdomains="true">kgimg.com</domain>
        <domain includeSubdomains="true">kuwo.cn</domain>
        <domain includeSubdomains="true">kwcdn.kuwo.cn</domain>
        <domain includeSubdomains="true">migu.cn</domain>
        <domain includeSubdomains="true">music.126.net</domain>
    </domain-config>
</network-security-config>
