<?xml version="1.0" encoding="utf-8"?>
<!--
  明文 http：音源脚本（用户自行导入）请求的接口和返回的播放地址来自任意域名，很多只有 http
  （桌面端、洛雪移动端同样放行），所以整体允许明文。Lyra 自己的后端和账号接口只走 https。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
